## You must first activate a Billing Account here: https://platform.openai.com/account/billing/overview
## Then get your OpenAI API Key here: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=XXXXXXXX

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
# In local dev you can get these by running `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CRM project (aim-crm). Not the site database.
# The admin bundle reads VITE_SUPABASE_URL and VITE_SB_PUBLISHABLE_KEY.
# `npm run build` copies CRM_SUPABASE_URL and CRM_SUPABASE_ANON_KEY into those.
CRM_SUPABASE_URL=
CRM_SUPABASE_ANON_KEY=
CRM_SUPABASE_SERVICE_ROLE_KEY=

## Follow GitHub Oauth setup steps from Supabase,
## if you choose not to use Github, set first
## value to "false"
NEXT_PUBLIC_AUTH_GITHUB=false
AUTH_GITHUB_ID=XXXXXXXX
AUTH_GITHUB_SECRET=XXXXXXXX

# Bearer token for POST /api/revalidate, called by the treatise publish Action.
REVALIDATE_SECRET=

# Chat models and guest limits (app/api/chat/route.ts, lib/guest-rate-limit.ts)
# CHAT_MODEL is the Anthropic model for a reader who saved an Anthropic key.
# The other defaults apply when that reader saved a different provider's key.
# A model saved on the profile overrides these.
CHAT_MODEL=claude-opus-5-5
GUEST_CHAT_MODEL=claude-sonnet-5
OPENAI_CHAT_MODEL=gpt-5.4
GOOGLE_CHAT_MODEL=gemini-3.8-flash
OPENROUTER_CHAT_MODEL=openai/gpt-5.4
# Guest questions per IP address, and across the whole site, per UTC day.
# Requires migration 20261112000000_guest_chat_usage.sql.
# These apply only when CHAT_ALLOW_GUESTS=true. The default is to refuse guests.
GUEST_DAILY_LIMIT_PER_IP=5
GUEST_DAILY_LIMIT_GLOBAL=100

# Chat is closed to anonymous visitors unless this is true.
CHAT_ALLOW_GUESTS=false
# Signed-in readers without a saved key use ANTHROPIC_API_KEY only when this is true.
# Leave it false so public chat cannot spend the site key.
CHAT_ALLOW_PLATFORM_KEY=false
# Encrypts keys saved in user_api_keys (migration 20261112020220_user_api_keys.sql).
# If unset, the service role key is the fallback. Rotating either makes saved keys unreadable.
BYOK_ENCRYPTION_KEY=
