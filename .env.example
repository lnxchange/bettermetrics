## You must first activate a Billing Account here: https://platform.openai.com/account/billing/overview
## Then get your OpenAI API Key here: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=XXXXXXXX

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
# In local dev you can get these by running `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CRM project (aim-crm). Not the site database.
# The admin bundle reads VITE_SUPABASE_URL and VITE_SB_PUBLISHABLE_KEY.
# `npm run build` copies CRM_SUPABASE_URL and CRM_SUPABASE_ANON_KEY into those.
CRM_SUPABASE_URL=
CRM_SUPABASE_ANON_KEY=
CRM_SUPABASE_SERVICE_ROLE_KEY=

## Follow GitHub Oauth setup steps from Supabase,
## if you choose not to use Github, set first
## value to "false"
NEXT_PUBLIC_AUTH_GITHUB=false
AUTH_GITHUB_ID=XXXXXXXX
AUTH_GITHUB_SECRET=XXXXXXXX

# Bearer token for POST /api/revalidate, called by the treatise publish Action.
REVALIDATE_SECRET=

# Chat models and guest limits (app/api/chat/route.ts, lib/guest-rate-limit.ts)
# Guests are answered by GUEST_CHAT_MODEL; signed-in readers by CHAT_MODEL.
CHAT_MODEL=claude-opus-5-5
GUEST_CHAT_MODEL=claude-sonnet-5
# Guest questions per IP address, and across the whole site, per UTC day.
# Requires migration 20261112000000_guest_chat_usage.sql.
GUEST_DAILY_LIMIT_PER_IP=5
GUEST_DAILY_LIMIT_GLOBAL=100
