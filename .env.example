## You must first activate a Billing Account here: https://platform.openai.com/account/billing/overview
## Then get your OpenAI API Key here: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=XXXXXXXX

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
# In local dev you can get these by running `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CRM project (aim-crm). Not the site database.
# The admin bundle reads VITE_SUPABASE_URL and VITE_SB_PUBLISHABLE_KEY.
# `npm run build` copies CRM_SUPABASE_URL and CRM_SUPABASE_ANON_KEY into those.
CRM_SUPABASE_URL=
CRM_SUPABASE_ANON_KEY=
CRM_SUPABASE_SERVICE_ROLE_KEY=

## Follow GitHub Oauth setup steps from Supabase,
## if you choose not to use Github, set first
## value to "false"
NEXT_PUBLIC_AUTH_GITHUB=false
AUTH_GITHUB_ID=XXXXXXXX
AUTH_GITHUB_SECRET=XXXXXXXX

# Bearer token for POST /api/revalidate, called by the treatise publish Action.
REVALIDATE_SECRET=

# Chat models. The admin AI settings page overrides these.
# CHAT_MODEL is kept as a fallback name for the Anthropic model.
CHAT_MODEL=claude-opus-5-5
CHAT_MODEL_ANTHROPIC=claude-opus-5-5
CHAT_MODEL_OPENAI=gpt-5.4
CHAT_MODEL_GOOGLE=gemini-3.1-pro-preview
CHAT_MODEL_OPENROUTER=anthropic/claude-opus-5-5
GUEST_CHAT_MODEL=claude-sonnet-5
# Guest questions per IP address, and across the whole site, per UTC day.
# Requires migration 20261112000000_guest_chat_usage.sql.
# These apply only when CHAT_ALLOW_GUESTS=true. The default is to refuse guests.
GUEST_DAILY_LIMIT_PER_IP=5
GUEST_DAILY_LIMIT_GLOBAL=100

# Emergency pause. When true, /api/chat refuses every question before any other work.
# This overrides the admin AI settings switch. A change takes effect on the next deployment.
CHAT_PAUSED=false
# Hard cap on Treatise characters attached to one question. The admin page is the everyday control.
TREATISE_CONTEXT_MAX_CHARS=60000
# Required in production. Encrypts keys in user_api_keys.
# Rotating it makes previously saved keys unreadable. Readers save them again.
BYOK_ENCRYPTION_KEY=
